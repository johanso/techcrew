# TechTeam settings. Almost everything is optional: copy this file to .env only to change something. A line that starts
# with # shows the default or an example; remove the # to use it. There are no secrets to put here: you sign in with GitHub
# from the app, and your AI keys are saved in Settings → AI (encrypted on this computer).

# The address you open TechTeam at. It listens on 127.0.0.1 only and refuses requests for any other host name (set this
# to your own domain if you put a reverse proxy in front). It must stay a local address for agents on your Claude plan.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Your data ──────────────────────────────────────────────────────────────────────────────────────────────────────

# ── Sign-in and secrets ─────────────────────────────────────────────────────────────────────────────────────────────
# Sign-in uses the project's GitHub OAuth App (device flow). A client id is public and there is no client secret. Forked
# TechTeam, or want your own app? Create an OAuth App with "Enable Device Flow" ticked
# (https://github.com/settings/developers) and set its client id here. See docs/setup.md.
# GITHUB_CLIENT_ID=

# Encrypts GitHub tokens and AI keys at rest (AES-256-GCM): 32 bytes as base64 (openssl rand -base64 32). Unset,
# TechTeam generates one in <TECHTEAM_DATA_DIR>/encryption.key on first use. Moving to another computer needs that file
# (or this same value); otherwise reconnect GitHub and enter your AI keys again.
# TOKEN_ENCRYPTION_KEY=

# ── AI providers ────────────────────────────────────────────────────────────────────────────────────────────────────


# ── Testing ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Simulated agents. When "true", agents follow a fixed script instead of calling a model: no key and no spend, but real
# GitHub work (a branch, one note file under agent-simulations/, a pull request).
# AGENTS_SIMULATED=false

