# TechTeam settings. Almost everything is optional: copy this file to .env only to change something. A line that starts
# with # shows the default or an example; remove the # to use it. There are no secrets to put here: you sign in with GitHub
# from the app, and your AI keys are saved in Settings → AI (encrypted on this computer).

# The address you open TechTeam at. It listens on 127.0.0.1 only and refuses requests for any other host name (set this
# to your own domain if you put a reverse proxy in front). It must stay a local address for agents on your Claude plan.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Your data ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Where TechTeam keeps its data: the database in <folder>/postgres and files (workspace logos, the Tester's screenshots,
# card references) in <folder>/files. Default: ~/.techteam/data
# TECHTEAM_DATA_DIR=

# Leave DATABASE_URL unset and `npm run dev` starts TechTeam's own Postgres (no Docker, no install). Set it to use a
# database you run yourself instead.
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database
# Port of the embedded Postgres (127.0.0.1 only).
# TECHTEAM_PG_PORT=54329

# ── Sign-in and secrets ─────────────────────────────────────────────────────────────────────────────────────────────
# Sign-in uses the project's GitHub OAuth App (device flow). A client id is public and there is no client secret. Forked
# TechTeam, or want your own app? Create an OAuth App with "Enable Device Flow" ticked
# (https://github.com/settings/developers) and set its client id here. See docs/setup.md.
# GITHUB_CLIENT_ID=

# Encrypts GitHub tokens and AI keys at rest (AES-256-GCM): 32 bytes as base64 (openssl rand -base64 32). Unset,
# TechTeam generates one in <TECHTEAM_DATA_DIR>/encryption.key on first use. Moving to another computer needs that file
# (or this same value); otherwise reconnect GitHub and enter your AI keys again.
# TOKEN_ENCRYPTION_KEY=

# ── AI providers ────────────────────────────────────────────────────────────────────────────────────────────────────
# Optional server-wide fallback, used only when neither your account nor the workspace has a key. Normally save your keys
# once in Settings → AI instead. Without any key the AI Team page still works with default instructions and rule-based
# trust scans. Leave these commented: a made-up value here counts as a real key.
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Anthropic (Claude API, pay as you go): https://platform.claude.com. A Claude subscription doesn't use a key: it runs
# through Claude Code (Settings → AI → Plans on this computer).
# ANTHROPIC_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys. One key and one credit balance for the Google, DeepSeek, Z.ai, xAI and
# Moonshot models. OpenRouter adds a small fee on credit.
# OPENROUTER_API_KEY=

# ── Agents on your own plan (Claude Code) ───────────────────────────────────────────────────────────────────────────
# Works only when TechTeam runs on your computer (a local NEXT_PUBLIC_APP_URL, no hosting platform). Nothing to switch on
# here: Settings → AI → Plans on this computer. "false" turns the feature off on this computer.
# AGENTS_LOCAL_CLI=
# Where TechTeam keeps its own Claude Code login and settings (default ~/.techteam/cli, %USERPROFILE%\.techteam\cli on
# Windows). Keep it outside the project folder, and never your normal Claude Code config folder.
# TECHTEAM_CLI_HOME=
# Claude Code's binary, when it isn't in ~/.local/bin, Homebrew or %USERPROFILE%\.local\bin.
# CLAUDE_CLI_PATH=
# Auto pickup runs on every computer whose Inngest is up (they share a database). "false" opts this one out.
# AGENTS_AUTO_PICKUP=

# ── Testing ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Simulated agents. When "true", agents follow a fixed script instead of calling a model: no key and no spend, but real
# GitHub work (a branch, one note file under agent-simulations/, a pull request).
# AGENTS_SIMULATED=false

# ── Agent sandbox (optional: Settings → Sandbox stays off without it) ───────────────────────────────────────────────
# A Docker host where agents run tests and builds in gVisor containers: a VPS prepared with deploy/setup.sh over SSH
# (e.g. ssh://techteam@203.0.113.10, or an alias from ~/.ssh/config), or unix:///var/run/docker.sock on that VPS.
# SANDBOX_DOCKER_HOST=
# The image sandboxes run (default node:24-bookworm).
# SANDBOX_IMAGE=
# Previews of agent pull requests: a domain whose wildcard record (*.preview.example.com) points at the sandbox host, where
# deploy/setup.sh runs Caddy. Each preview is served at https://pr-<n>-<random>.<domain>.
# SANDBOX_PREVIEW_DOMAIN=
# The sandbox browser image for the Tester's browser and link captures (built on the host from deploy/browser).
# SANDBOX_BROWSER_IMAGE=
