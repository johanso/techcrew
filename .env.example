# App Setup
# TechTeam listens on 127.0.0.1 only. Requests for any other host name are refused (set this to your own domain if you
# put a reverse proxy in front).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM). Optional: leave DATABASE_URL unset and `npm run dev` starts TechTeam's own Postgres
# (data in <TECHTEAM_DATA_DIR>/postgres, default ~/.techteam/data/postgres). Set it to use your own database instead.
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database
# Port of the embedded Postgres (127.0.0.1 only). Default 54329.
# TECHTEAM_PG_PORT=54329

# Inngest Background Jobs & Cron Scheduler
# Local Dev: `npm run dev` starts the Inngest Dev Server with the app (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# Where TechTeam keeps its local data: workspace logos, the Tester's screenshots and card references live in
# <folder>/files (served through the app, never public). Optional; default: ~/.techteam/data
# TECHTEAM_DATA_DIR=

# Sign-in uses the project's GitHub OAuth App by default (Device Flow). A client id is public and there is no client
# secret. Fork TechTeam, or want your own app? Create an OAuth App with "Enable Device Flow" ticked
# (https://github.com/settings/developers) and set its client id here. See docs/setup.md.
# GITHUB_CLIENT_ID=

# Encrypts GitHub tokens and AI keys at rest (AES-256-GCM): 32 bytes as base64 (openssl rand -base64 32). Optional: unset,
# TechTeam generates one in <TECHTEAM_DATA_DIR>/encryption.key on first use. Moving to another computer needs that file
# (or this same value), otherwise reconnect GitHub and enter your AI keys again.
# TOKEN_ENCRYPTION_KEY=

# AI providers — optional server-wide fallback. Users normally save their keys once in Settings → Your account →
# AI keys (encrypted with TOKEN_ENCRYPTION_KEY); these are used only when neither the account nor the workspace has one.
# Without any key the AI Team page still works with default instructions and rule-based trust scans.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# Anthropic (Claude): https://platform.claude.com — an API key from the Console (pay as you go; a Claude.ai
# subscription can't be used by this app).
ANTHROPIC_API_KEY=your_anthropic_api_key
# OpenRouter: https://openrouter.ai/settings/keys — one key and one credit balance for Google, DeepSeek, Z.ai, xAI and
# Moonshot models (the OpenRouter models in lib/agent-config.ts). Pay as you go; OpenRouter adds a small fee on credit.
OPENROUTER_API_KEY=your_openrouter_api_key

# Simulated agents — local testing only. When "true", agents follow a fixed script instead of calling a model:
# no API key and no spend, but real GitHub work (a branch, one note file under agent-simulations/, a PR).
AGENTS_SIMULATED=false

# Agents on your own plans through a local CLI (Claude Code): only when TechTeam runs on your computer (a local
# NEXT_PUBLIC_APP_URL, no hosting platform). Nothing to switch on here: Settings → AI → Plans on this computer.
# "false" turns the feature off on this computer.
AGENTS_LOCAL_CLI=
# Where TechTeam keeps its own CLI login and settings (default ~/.techteam/cli, %USERPROFILE%\.techteam\cli on Windows).
# Keep it outside the project folder. Never your normal Claude Code config folder.
TECHTEAM_CLI_HOME=
# Claude Code's binary, when it isn't in ~/.local/bin, Homebrew or %USERPROFILE%\.local\bin.
CLAUDE_CLI_PATH=
# Auto pickup runs on every computer whose Inngest is up (they share the database). "false" opts this one out.
AGENTS_AUTO_PICKUP=

# Agent sandboxes (Settings → Sandbox): the Docker host that runs agents' tests and builds in gVisor containers.
# A VPS prepared with deploy/setup.sh over SSH (e.g. ssh://techteam@203.0.113.10, or an alias from ~/.ssh/config),
# or unix:///var/run/docker.sock when the app runs on that VPS. Unset: the sandbox can't be switched on.
SANDBOX_DOCKER_HOST=
# Optional: the image sandboxes run (default node:24-bookworm, pulled by deploy/setup.sh).
SANDBOX_IMAGE=
# Previews of agent pull requests (Settings → Sandbox → Previews): a domain whose wildcard record
# (*.preview.example.com) points at the sandbox host, where deploy/setup.sh runs Caddy. Each preview is served at
# https://pr-<n>-<random>.<domain>. Unset: previews can't be switched on.
SANDBOX_PREVIEW_DOMAIN=preview.example.com
# Optional: the sandbox browser image, for the Tester's browser and link captures (default techteam-browser:1.64.1-3,
# built on the host from deploy/browser).
SANDBOX_BROWSER_IMAGE=
